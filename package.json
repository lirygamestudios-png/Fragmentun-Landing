  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@10.8.2",
  "overrides": {
